font-size: 1.1rem;
color: var(–accent);
font-weight: 600;
margin-bottom: .5rem;
}

.rp-contact {
display: flex;
flex-wrap: wrap;
gap: .3rem .8rem;
font-size: .82rem;
color: var(–text-muted);
}

.rp-contact span {
display: inline-flex;
align-items: center;
}

.rp-contact span:not(:last-child)::after {
content: “•”;
margin-left: .8rem;
color: var(–border);
}

.resume-paper h3 {
font-size: .85rem;
text-transform: uppercase;
letter-spacing: .06em;
color: var(–accent);
border-bottom: 2px solid var(–accent-soft);
padding-bottom: .25rem;
margin: 1.4rem 0 .65rem;
font-weight: 700;
}

.rp-summary {
margin-bottom: .25rem;
color: var(–text);
}

.rp-exp-item {
margin-bottom: .85rem;
}

